FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY packages ./packages
COPY services ./services
COPY detections ./detections
COPY blue_range ./blue_range
COPY migrations ./migrations
COPY scripts ./scripts

RUN pip install --no-cache-dir -e .

ENV BTOS_API_HOST=0.0.0.0
ENV BTOS_API_PORT=8080
ENV BTOS_OBJECT_STORE_ROOT=/data/objects

EXPOSE 8080

# Bootstrap adds package paths at import time; migrate patches hosted Postgres columns.
CMD ["sh", "-c", "python scripts/migrate.py && python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --app-dir services/api"]
