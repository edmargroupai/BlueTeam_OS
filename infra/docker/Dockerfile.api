FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY packages ./packages
COPY services ./services
COPY detections ./detections
COPY blue_range ./blue_range
COPY migrations ./migrations
COPY scripts ./scripts

RUN pip install --no-cache-dir -e .

ENV BTOS_API_HOST=0.0.0.0
ENV BTOS_API_PORT=8080
ENV BTOS_OBJECT_STORE_ROOT=/tmp/objects
# Railway injects PORT; default 8080 for local docker runs.
ENV PORT=8080

EXPOSE 8080

# Portable entrypoint: migrate control-plane schema, then serve on $PORT.
CMD ["sh", "-c", "python scripts/migrate.py && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080} --app-dir services/api"]
