# Blue Team OS Center — environment template
# Copy to .env and replace every CHANGE_ME value before running locally.
# Never commit a real .env file.

BTOS_ENV=development
BTOS_LOG_LEVEL=INFO
BTOS_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string
BTOS_API_HOST=0.0.0.0
BTOS_API_PORT=8080
BTOS_API_PUBLIC_URL=http://127.0.0.1:8080
BTOS_WEB_ORIGIN=http://127.0.0.1:3000
# Production: comma-separated approved frontend origins (Vercel production URL, etc.).
# BTOS_CORS_ORIGINS=https://blueteam-os.vercel.app
# Optional preview regex (production only when explicitly set):
# BTOS_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Control-plane database. SQLite is allowed for local/CI only.
# Production and Docker Compose use PostgreSQL.
BTOS_DATABASE_URL=sqlite:///./data/blueteam.db
# BTOS_DATABASE_URL=postgresql+psycopg://blueteam:CHANGE_ME@localhost:5432/blueteam

# Optional data-plane endpoints. Empty means "not configured" — health reports degraded, not fabricated.
BTOS_REDIS_URL=redis://localhost:6379/0
BTOS_CLICKHOUSE_URL=
BTOS_OPENSEARCH_URL=
BTOS_KAFKA_BOOTSTRAP=
BTOS_S3_ENDPOINT=
BTOS_S3_BUCKET=blueteam-evidence
BTOS_S3_ACCESS_KEY=
BTOS_S3_SECRET_KEY=
BTOS_OBJECT_STORE_ROOT=./data/objects
BTOS_RETENTION_EVENTS_DAYS=90
BTOS_RETENTION_DEAD_LETTER_DAYS=30
BTOS_RETENTION_FINDINGS_DAYS=365

# Supabase project metadata. Database password stays in .env.local only.
# Prefer the session pooler host when direct db.<ref>.supabase.co fails DNS.
# Example: postgresql+psycopg://postgres.<PROJECT_REF>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
BTOS_SUPABASE_URL=
BTOS_SUPABASE_PUBLISHABLE_KEY=

# Local development seed. Disabled automatically when BTOS_ENV=production.
BTOS_DEV_SEED=true
BTOS_DEV_PASSWORD=CHANGE_ME_dev_only

# Auth
BTOS_ACCESS_TOKEN_MINUTES=30
BTOS_REFRESH_TOKEN_DAYS=7
BTOS_OIDC_ISSUER=
BTOS_OIDC_CLIENT_ID=
BTOS_OIDC_CLIENT_SECRET=
BTOS_OIDC_JWKS_URL=

# AI Gateway — feature code must never call a provider SDK.
# Leave disabled. The platform must operate with AI offline.
BTOS_AI_ENABLED=false
BTOS_AI_PROVIDER=

# Quality index calculation version. Do not change without a signed model update.
BTOS_QUALITY_MODEL_VERSION=qi-1.0.0
